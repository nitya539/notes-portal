<%- include('partials-head') %>

<main class="container">
  <h1>Upload a Note or Resource</h1>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form class="upload-form" method="POST" action="/upload" enctype="multipart/form-data">
    <label>Title
      <input type="text" name="title" placeholder="e.g. Unit 3 - Data Structures" required>
    </label>

    <label>Subject
      <input type="text" name="subject" placeholder="e.g. Computer Science" required>
    </label>

    <label>Your Name (optional)
      <input type="text" name="uploader" placeholder="e.g. Priya">
    </label>

    <label>File (PDF, Word, PPT, TXT, or Image — max 15MB)
      <input type="file" name="file" required>
    </label>

    <button type="submit" class="btn-nav">Upload</button>
  </form>

  <a href="/" class="back-link">← Back to all notes</a>
</main>
</body>
</html>
